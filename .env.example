# --- Copy to `.env` at the repo root (next to docker-compose.yml) ---

# Django
SECRET_KEY=change-me-generate-a-real-django-secret-key
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Postgres (docker-compose `db` service)
DB_NAME=eds
DB_USER=eds
DB_PASSWORD=change-me-strong-password

# Optional: use a single URL instead of DB_* (uncomment and adjust)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Media storage — Cloudinary ONLY. Every upload (CVs, blog covers,
# testimonial photos) goes to Cloudinary; there is no local-disk fallback.
# All three are required or uploads fail (see Expert_Registration/models.py
# cv_storage, Content/models.py content_image_storage).
CLOUD_NAME=your-cloudinary-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret

# Email (password reset, notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=change-me-app-password

# Full URL users open for password reset (must match public SPA URL)
FRONTEND_RESET_URL=https://your-domain.com/reset-password

# Frontend: empty = browser calls same origin `/api/...` (recommended with bundled nginx)
VITE_API_BASE_URL=

# Host port mapping for docker-compose `web`
HTTP_PORT=80

# Gunicorn workers inside backend container (optional)
GUNICORN_WORKERS=3